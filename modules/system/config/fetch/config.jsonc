
{
 "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // "color": {"1": "white"},
	"type":"kitty-direct",
	"height":10,
	"width":22,
        "source": "~/.config/fastfetch/images/nixglass.png",
        "padding": {
            "top": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " •  "
    },
    "modules": [
	"break",
	"break",
	{
            "type": "title",
            "color": {
                "user": "35",  // = color2
                "at": "35",
                "host": "35"
            }
        },
        "break",
        {
            "type": "os",
            "key": "macOS          ",
            "keyColor": "35",
        },
        {
            "type": "kernel",
            "key": "darwin         ",
            "keyColor": "35",
        },
        {
            "type": "packages",
            "format": "{} (nix-darwin)",
            "key": "packages       ",
            "keyColor": "35",
        },
        {
            "type": "shell",
            "key": "unix shell     ",
            "keyColor": "35",
        },
        {
            "type": "terminal",
            "key": "terminal       ",
            "keyColor": "35",
        },
        {
            "type": "wm",
            "format": "omniWM",
            "key": "window manager ",
            "keyColor": "35",
        },
	{
            "type": "command",
            "key": "nix version    ",
	    "text": "nix --version | awk '{print $3}'",
            "keyColor": "35",
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
        },	
        "break",
        "break",
    ]
}
