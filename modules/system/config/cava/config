[general]
live-config = 1
framerate = 120
bars = 0
center_align = 1

[input]
method = coreaudio
source = tap

[output]
method = noncurses

[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '#ff007f'
gradient_color_2 = '#e0115f'
gradient_color_3 = '#b026ff'
gradient_color_4 = '#7851a9'
gradient_color_5 = '#4b0082'
gradient_color_6 = '#311432'
gradient_color_7 = '#1a0933'
gradient_color_8 = '#090214'
blend_direction = 'up'

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 77

[eq]
; 1 = 1 # bass
; 2 = 1
; 3 = 1 # midtone
; 4 = 1
; 5 = 1 # treble
